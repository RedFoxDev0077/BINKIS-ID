# ---------------------------------------------------------------------------
# BINKIS ID — environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Primary registry database.
DATABASE_URL="postgresql://binkis:binkis@localhost:5432/binkis_id?schema=public"

# Ephemeral database used by the batch generator to prove every generated
# claim code actually claims its intended piece. Wiped after each run.
# Leave unset to let the generator boot a throwaway embedded PostgreSQL.
STAGING_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Claim Code pepper.
#
# Claim codes are stored ONLY as HMAC-SHA256(pepper, normalised_code).
# This pepper is the entire security boundary: leaking it turns the code
# hashes back into a guessable offline target. It must be >= 32 bytes of
# real entropy, must live outside the database, and must NEVER be rotated
# once a batch has been printed (rotation invalidates every physical
# hologram already in the world).
#
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
CLAIM_CODE_PEPPER=""

# Public origin baked into every QR payload: {PUBLIC_ORIGIN}/p/{qr_token}
# Changing this after a batch is printed breaks every printed sticker.
PUBLIC_ORIGIN="https://id.binkis.com"

# ---------------------------------------------------------------------------
# Factory export encryption.
# The .xlsx handed to the factory is the ONLY artefact on earth that contains
# plaintext claim codes. It is shipped as an AES-256-GCM archive.
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
FACTORY_EXPORT_KEY=""
