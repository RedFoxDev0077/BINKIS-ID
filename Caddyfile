# BINKIS ID reverse proxy.
#
# Caddy obtains and renews the certificate automatically over ACME. That
# requires id.binkis.com to already resolve to this server and port 80 to be
# reachable, which is why the DNS A record is a hard prerequisite rather than
# a tidy-up task.

{
	# Staging CA would avoid rate limits during testing, but this domain is
	# printed inside 137,000 QR codes and needs a genuinely trusted cert.
	servers {
		trusted_proxies static private_ranges
	}
}

id.binkis.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# A passport page is public data about an object, not about a person.
		# It should be indexable and shareable, so no restrictive CSP here yet;
		# that lands with the real pages in build step 3.
		-Server
	}

	# Character art and animation, served straight off disk. It never changes
	# for a given file name, it is far larger than anything the app returns,
	# and it has no reason to occupy a Node process. Immutable caching is safe
	# because a new cut of a character ships under a new file name.
	handle /characters/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Brand media: the mascot, which belongs to no piece.
	handle /brand/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# The display case layers and the matched-set film. Same arrangement as
	# the character art: large, static, and no reason to occupy a Node
	# process. The film is the one file here a collector waits on, so it is
	# served with range requests, which file_server does by default.
	handle /vitrina/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle /celebracion/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# Aguila's illustrations for the claim tutorial.
	handle /binkis-tutorial/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# UNIVERSALS comic pages. The largest files the site serves by a wide
	# margin, and the only ones a reader looks at for minutes rather than
	# seconds, so they have even less business occupying a Node process than
	# the character art does. Immutable for the same reason: a re-lettered
	# page ships under a new file name.
	handle /comics/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	# UNIVERSALS animation. Megabytes per clip, and the one media here that a
	# browser fetches in pieces: file_server answers range requests by default,
	# which is what lets somebody scrub the timeline without re-downloading the
	# whole file, and what lets a dropped connection resume.
	#
	# Immutable for the same reason as everything else under /srv/media: a new
	# cut ships under a new file name. That matters more here than anywhere -
	# the client has already said the clip "va a cambiar mejorar poquito", and
	# overwriting one of these in place would leave every phone that had
	# watched it holding the old cut until November 2027.
	handle /videos/* {
		root * /srv/media
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	reverse_proxy app:3000 {
		health_uri /
		health_interval 10s
		health_timeout 5s
	}

	# A MISSING FILE MUST NEVER BE CACHED, LET ALONE MARKED IMMUTABLE.
	#
	# Every media block above sets a one-year immutable Cache-Control, and the
	# header directive applies to whatever file_server returns - including a
	# 404. So a browser that asked for a comic page in the window before the
	# art was uploaded was told, with full authority, "this URL is empty and
	# will still be empty in a year, do not even revalidate".
	#
	# That is exactly what happened on 6 and 7 November 2026. The client
	# reported "aun no se cargan las imagenes" three times while every check
	# from a fresh client returned 200, because a fresh client had no poisoned
	# entry and his phone would not re-request for a year.
	#
	# Media here is uploaded by hand, separately from the deploy, so the gap
	# between "the page mentions a file" and "the file is on disk" is a normal
	# state of this system rather than an accident. The caching policy has to
	# survive it.
	handle_errors {
		header Cache-Control "no-store"
		header -Etag
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}

	log {
		output stdout
		format console
	}
}

# Temporary. Lets the stack be verified by IP before the DNS record exists,
# and lets us prove Caddy reaches the app container independently of ACME.
# Remove once id.binkis.com resolves and TLS is confirmed working.
:80 {
	reverse_proxy app:3000
}
